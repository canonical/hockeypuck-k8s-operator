#!/bin/bash
# Copyright 2026 Canonical Ltd.
# See LICENSE file for licensing details.

# Sign commits with the first key of the host SSH agent
# (connected with `workshop connect dev/git:ssh-agent`).
# Users can override these settings with `git config --global`.
set -euo pipefail

git config --system gpg.format ssh
git config --system gpg.ssh.defaultKeyCommand \
    "sh -c 'key=\$(ssh-add -L 2>/dev/null | head -n1) && [ -n \"\$key\" ] && echo key::\$key || { echo \"No SSH agent. Run on the host: workshop connect dev/git:ssh-agent\" >&2; exit 1; }'"
git config --system commit.gpgsign true
